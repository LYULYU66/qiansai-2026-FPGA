`timescale 1ns/1ps
// Red live needles for the TF5 instrument-cluster background.
// The background is static artwork; this small overlay supplies the two
// radial needles without touching the cached image or HDMI timing.
// 20261021: incremental form of the original per-pixel test
//   hit = (x,y) inside the box spanned by (CX,CY)-(ex,ey) and
//         |(x-CX)*(ey-CY) - (y-CY)*(ex-CX)| <= 3*max(|ex-CX|,|ey-CY|).
// The products are carried by a column and a row accumulator (one add each
// per pixel / per line) instead of two multipliers per gauge.  The six
// endpoint pairs are elaboration-time constants selected by I_state, which
// the caller holds for a whole frame.
module gauge_needle_dynamic #(
    parameter integer CX=145, CY=240,
    parameter integer EX0=0, EY0=0, EX1=0, EY1=0, EX2=0, EY2=0,
    parameter integer EX3=0, EY3=0, EX4=0, EY4=0, EX5=0, EY5=0
) (
    input  wire        clk, rst,
    input  wire [2:0]  state,       // 0..5, constant within a frame
    input  wire [10:0] x, px,       // next and registered raster x
    input  wire [9:0]  y, py,       // next and registered raster y
    output wire        hit
);
function integer iabs(input integer v); iabs=(v<0)?-v:v; endfunction
function integer imax(input integer a,input integer b); imax=(a>b)?a:b; endfunction
function integer imin(input integer a,input integer b); imin=(a<b)?a:b; endfunction
`define GN_ROW(N,EX,EY) N: begin A=(EY)-CY; B=(EX)-CX; K=-CX*((EY)-CY); L=CY*((EX)-CX);     T=3*imax(iabs((EX)-CX),iabs((EY)-CY)); X0=imin(EX,CX); X1=imax(EX,CX); Y0=imin(EY,CY); Y1=imax(EY,CY); end
reg signed [19:0] A,B,K,L,T;
reg [10:0] X0,X1;
reg [9:0]  Y0,Y1;
always @* begin
    case(state)
        `GN_ROW(3'd0,EX0,EY0)
        `GN_ROW(3'd1,EX1,EY1)
        `GN_ROW(3'd2,EX2,EY2)
        `GN_ROW(3'd3,EX3,EY3)
        `GN_ROW(3'd4,EX4,EY4)
        default: begin A=(EY5)-CY; B=(EX5)-CX; K=-CX*((EY5)-CY); L=CY*((EX5)-CX);
            T=3*imax(iabs((EX5)-CX),iabs((EY5)-CY)); X0=imin(EX5,CX); X1=imax(EX5,CX);
            Y0=imin(EY5,CY); Y1=imax(EY5,CY); end
    endcase
end
`undef GN_ROW
// col = (x-CX)*A for the next pixel; row = -(y-CY)*B for the next line.
reg signed [19:0] col,row;
wire signed [19:0] col_next=(x==11'd0) ? K : (x!=px) ? col+A : col;
wire signed [19:0] row_next=(y==10'd0) ? L : (y!=py) ? row-B : row;
always @(posedge clk or posedge rst) begin
    if(rst) begin col<=0; row<=0; end
    else begin col<=col_next; row<=row_next; end
end
wire signed [20:0] cross=col_next+row_next;
wire [20:0] cross_abs=cross[20] ? -cross : cross;
assign hit=x>=X0 && x<=X1 && y>=Y0 && y<=Y1 && cross_abs<={1'b0,T};
endmodule

module video_dashboard_needles #(
    parameter integer STEP_CYCLES=12_500_000,
    parameter integer DEBOUNCE_CYCLES=250_000
) (
    input  wire        I_clk,
    input  wire        I_rst,
    input  wire        I_enable,
    input  wire        I_vs,
    input  wire        I_de,
    input  wire        I_boost_key_n,
    input  wire [23:0] I_rgb,
    output wire [23:0] O_rgb
);
localparam integer STEP_BITS=(STEP_CYCLES>1)?$clog2(STEP_CYCLES):1;
localparam integer KEY_BITS=(DEBOUNCE_CYCLES>1)?$clog2(DEBOUNCE_CYCLES+1):1;

// Keep the button as a level: pressed = active-low key is held low.
reg key_meta,key_sync,key_stable;
reg [KEY_BITS-1:0] key_count;
always @(posedge I_clk or posedge I_rst) begin
    if(I_rst) begin
        key_meta<=1'b0; key_sync<=1'b0; key_stable<=1'b0; key_count<=0;
    end else begin
        key_meta<=~I_boost_key_n;
        key_sync<=key_meta;
        if(key_sync==key_stable) begin
            key_count<=0;
        end else if(key_count==DEBOUNCE_CYCLES-1) begin
            key_stable<=key_sync;
            key_count<=0;
        end else begin
            key_count<=key_count+1'b1;
        end
    end
end

// Use a small triangle sweep in the normal state so the needles only drift
// a few pixels around their nominal position.  The boost state still uses the
// full 4/5 and 100/120 excursion, but moves through a midpoint for a cleaner
// visual transition.
reg [STEP_BITS-1:0] step_count;
reg [1:0] sweep_step;
always @(posedge I_clk or posedge I_rst) begin
    if(I_rst) begin step_count<=0; sweep_step<=0; end
    else if(step_count==STEP_CYCLES-1) begin
        step_count<=0;
        case (sweep_step)
            2'd0:    sweep_step<=2'd1;
            2'd1:    sweep_step<=2'd2;
            default: sweep_step<=2'd1;
        endcase
    end else step_count<=step_count+1'b1;
end

// Raster position. next_x/next_y is the pixel represented by the current
// I_de/I_rgb pair, matching the existing video overlays in this project.
reg [10:0] pixel_x,next_x;
reg [9:0]  pixel_y,next_y;
reg de_d,vs_d,active_seen,next_seen;
wire frame_start=I_vs && !vs_d;
wire line_start=I_de && !de_d;
always @* begin
    next_x=pixel_x; next_y=pixel_y; next_seen=active_seen;
    if(frame_start) begin
        next_x=0; next_y=0; next_seen=0;
    end else if(I_de) begin
        if(line_start) begin
            next_x=0;
            if(!active_seen) begin next_y=0; next_seen=1; end
            else if(pixel_y<479) next_y=pixel_y+1'b1;
        end else if(pixel_x<639) next_x=pixel_x+1'b1;
    end else next_x=0;
end
always @(posedge I_clk or posedge I_rst) begin
    if(I_rst) begin
        pixel_x<=0; pixel_y<=0; de_d<=0; vs_d<=0; active_seen<=0;
    end else begin
        pixel_x<=next_x; pixel_y<=next_y;
        de_d<=I_de; vs_d<=I_vs; active_seen<=next_seen;
    end
end

// Endpoints are calibrated to the final 640x480 artwork (values unchanged,
// see gauge_needle_dynamic parameters).  State 0..2 = normal sweep steps
// 0,1,2(3); 3..5 = boost.  It is latched at each frame start so a needle is
// never drawn with two different endpoints within one frame.
reg [2:0] needle_state;
always @(posedge I_clk or posedge I_rst) begin
    if(I_rst) needle_state<=3'd0;
    else if(frame_start)
        needle_state<=(key_stable ? 3'd3 : 3'd0)+((sweep_step==2'd0) ? 3'd0 :
                                                  (sweep_step==2'd1) ? 3'd1 : 3'd2);
end
wire rpm_line,spd_line;
gauge_needle_dynamic #(.CX(145),.CY(240),
    .EX0(47),.EY0(235),.EX1(48),.EY1(230),.EX2(49),.EY2(225),
    .EX3(145),.EY3(140),.EX4(172),.EY4(148),.EX5(200),.EY5(157)) u_rpm_needle (
    .clk(I_clk),.rst(I_rst),.state(needle_state),
    .x(next_x),.px(pixel_x),.y(next_y),.py(pixel_y),.hit(rpm_line));
gauge_needle_dynamic #(.CX(495),.CY(240),
    .EX0(403),.EY0(208),.EX1(405),.EY1(203),.EX2(407),.EY2(198),
    .EX3(495),.EY3(140),.EX4(518),.EY4(145),.EX5(540),.EY5(151)) u_spd_needle (
    .clk(I_clk),.rst(I_rst),.state(needle_state),
    .x(next_x),.px(pixel_x),.y(next_y),.py(pixel_y),.hit(spd_line));
wire rpm_hub=(next_x>=141 && next_x<=149 && next_y>=236 && next_y<=244);
wire spd_hub=(next_x>=491 && next_x<=499 && next_y>=236 && next_y<=244);
wire needle_on=I_enable && I_de && (rpm_line || spd_line || rpm_hub || spd_hub);
assign O_rgb=needle_on ? 24'hF01828 : I_rgb;
endmodule

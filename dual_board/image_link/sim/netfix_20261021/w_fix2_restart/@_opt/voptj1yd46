library verilog;
use verilog.vl_types.all;
entity audio_playback_progress is
    port(
        audio_clk       : in     vl_logic;
        udp_clk         : in     vl_logic;
        rst             : in     vl_logic;
        sample_read     : in     vl_logic;
        played_words    : out    vl_logic_vector(31 downto 0)
    );
end audio_playback_progress;

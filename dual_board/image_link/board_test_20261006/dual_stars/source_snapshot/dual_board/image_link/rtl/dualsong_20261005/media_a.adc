# Formal A player: retain original HDMI/keys/switches/segments, add tested PHY1.
# No PC UART on A. TF outputs are safely tied inactive in the top; card is on B.
set_pin_assignment { clk } { LOCATION = R7; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { rst_n } { LOCATION = A2; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { key1 } { LOCATION = B2; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { key2 } { LOCATION = C1; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { key_song } { LOCATION = B1; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { sw_rear } { LOCATION = C8; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { sw_front } { LOCATION = C7; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { sw_left } { LOCATION = C6; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { sw_right } { LOCATION = C5; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { HDMI_DDC_SCL } { LOCATION = P2; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment { HDMI_DDC_SDA } { LOCATION = R2; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
